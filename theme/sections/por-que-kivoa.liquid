{%- comment -%}
  "¿Por qué Kivoa?": el eslogan (un cuadro personalizado, no un cuadro cualquiera) contado en dos partes:
  - pilares: lo que significa el cuadro (emoción, personalización, recuerdo).
  - tabla: Kivoa frente a un cuadro cualquiera, solo con lo que de verdad ofrecemos.
  Bloques "pilar" y "fila" editables desde el editor del tema.
{%- endcomment -%}
{%- liquid
  assign pilares = section.blocks | where: 'type', 'pilar'
  assign filas = section.blocks | where: 'type', 'fila'
-%}
<div class="kpq" id="kpq-{{ section.id }}">
  <div class="kpq__cabecera">
    {%- if section.settings.etiqueta != blank -%}<p class="kpq__etiqueta">{{ section.settings.etiqueta }}</p>{%- endif -%}
    <h2 class="kpq__titulo">{{ section.settings.titulo }}</h2>
    {%- if section.settings.subtitulo != blank -%}<p class="kpq__sub">{{ section.settings.subtitulo }}</p>{%- endif -%}
  </div>

  {%- if section.settings.mostrar_pilares and pilares.size > 0 -%}
    <div class="kpq__pilares">
      {%- for block in pilares -%}
        <div class="kpq__pilar" {{ block.shopify_attributes }}>
          <span class="kpq__icono" aria-hidden="true">
            {%- case block.settings.icono -%}
              {%- when 'corazon' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 7.5 2.5C19.5 15.4 12 20 12 20z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- when 'pincel' -%}<svg viewBox="0 0 24 24"><path d="M14.5 4.5l5 5-8.2 8.2-5-5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6.3 12.7c-2 0-3.3 1.6-3.3 3.6 0 1.4-.5 2.4-1 3.2 3.4.4 6.6-.7 7.3-3.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              {%- when 'huella' -%}<svg viewBox="0 0 24 24"><ellipse cx="12" cy="16" rx="4.2" ry="3.6" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="6" cy="10.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="18" cy="10.5" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="9.3" cy="6.3" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="14.7" cy="6.3" r="1.8" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><rect x="4" y="3.5" width="16" height="17" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><rect x="7.5" y="7" width="9" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
            {%- endcase -%}
          </span>
          <h3>{{ block.settings.titulo }}</h3>
          <p>{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if filas.size > 0 -%}
    <div class="kpq__tabla" role="table" aria-label="{{ section.settings.titulo | escape }}">
      <div class="kpq__fila kpq__fila--cabeza" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="kpq__kivoa">{{ section.settings.col_kivoa }}</span>
        <span role="columnheader">{{ section.settings.col_otro }}</span>
      </div>
      {%- for block in filas -%}
        <div class="kpq__fila" role="row" {{ block.shopify_attributes }}>
          <span role="rowheader" class="kpq__concepto">{{ block.settings.concepto }}</span>
          <span role="cell" class="kpq__kivoa">
            <svg class="kpq__si" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.3l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- if block.settings.kivoa != blank -%}<span>{{ block.settings.kivoa }}</span>{%- else -%}<span class="kpq__oculto">Sí</span>{%- endif -%}
          </span>
          <span role="cell" class="kpq__otro">
            {%- if block.settings.otro_tiene -%}
              <svg class="kpq__medio" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            {%- else -%}
              <svg class="kpq__no" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            {%- endif -%}
            {%- if block.settings.otro != blank -%}<span>{{ block.settings.otro }}</span>{%- else -%}<span class="kpq__oculto">No</span>{%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.cierre != blank or section.settings.boton_texto != blank -%}
    <div class="kpq__cierre">
      {%- if section.settings.cierre != blank -%}<p>{{ section.settings.cierre }}</p>{%- endif -%}
      {%- if section.settings.boton_texto != blank -%}
        <a class="button" href="{{ section.settings.boton_enlace | default: '/collections/all' }}">{{ section.settings.boton_texto }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<style>
  #kpq-{{ section.id }} { --kpq-salvia: 63 81 71; max-width: 980px; margin: 0 auto; padding: 56px 16px; display: grid; gap: 32px; }
  @media (min-width: 750px) { #kpq-{{ section.id }} { padding: 80px 16px; gap: 40px; } }
  #kpq-{{ section.id }} .kpq__cabecera { text-align: center; max-width: 640px; margin: 0 auto; }
  #kpq-{{ section.id }} .kpq__etiqueta { margin: 0 0 8px; color: rgb(var(--kpq-salvia)); font-weight: 700; font-size: .8125rem; letter-spacing: .08em; text-transform: uppercase; }
  #kpq-{{ section.id }} .kpq__titulo { margin: 0 0 12px; }
  #kpq-{{ section.id }} .kpq__sub { margin: 0; font-size: 1.0625rem; opacity: .8; }
  #kpq-{{ section.id }} .kpq__pilares { display: grid; gap: 12px; }
  @media (min-width: 750px) { #kpq-{{ section.id }} .kpq__pilares { grid-template-columns: repeat(3, 1fr); gap: 16px; } }
  #kpq-{{ section.id }} .kpq__pilar { padding: 22px 20px; border-radius: 14px; background: rgb(var(--kpq-salvia) / .06); }
  #kpq-{{ section.id }} .kpq__icono { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: rgb(var(--kpq-salvia)); color: #fff; margin-bottom: 12px; }
  #kpq-{{ section.id }} .kpq__icono svg { width: 22px; height: 22px; }
  #kpq-{{ section.id }} .kpq__pilar h3 { margin: 0 0 6px; font-size: 1.25rem; }
  #kpq-{{ section.id }} .kpq__pilar p { margin: 0; line-height: 1.5; opacity: .85; }
  @media (max-width: 749px) {
    #kpq-{{ section.id }} .kpq__pilar { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 14px; padding: 16px; }
    #kpq-{{ section.id }} .kpq__icono { width: 40px; height: 40px; margin: 0; grid-row: span 2; }
    #kpq-{{ section.id }} .kpq__pilar h3 { font-size: 1.0625rem; margin-bottom: 4px; }
    #kpq-{{ section.id }} .kpq__pilar p { font-size: .9375rem; }
  }
  #kpq-{{ section.id }} .kpq__tabla { border-radius: 14px; overflow: hidden; border: 1px solid rgb(var(--kpq-salvia) / .18); }
  #kpq-{{ section.id }} .kpq__fila { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 1fr); align-items: stretch; }
  #kpq-{{ section.id }} .kpq__fila > span { padding: 13px 12px; display: flex; gap: 8px; align-items: center; font-size: .9375rem; line-height: 1.35; }
  #kpq-{{ section.id }} .kpq__fila:not(.kpq__fila--cabeza) + .kpq__fila > span { border-top: 1px solid rgb(var(--kpq-salvia) / .12); }
  #kpq-{{ section.id }} .kpq__fila--cabeza > span { font-weight: 700; font-size: .875rem; letter-spacing: .02em; padding-block: 14px; }
  #kpq-{{ section.id }} .kpq__kivoa { background: rgb(var(--kpq-salvia) / .08); }
  #kpq-{{ section.id }} .kpq__fila--cabeza .kpq__kivoa { background: rgb(var(--kpq-salvia)); color: #fff; }
  #kpq-{{ section.id }} .kpq__concepto { font-weight: 600; }
  #kpq-{{ section.id }} .kpq__otro { opacity: .7; }
  #kpq-{{ section.id }} .kpq__fila svg { flex: none; width: 20px; height: 20px; }
  #kpq-{{ section.id }} .kpq__si { color: rgb(var(--kpq-salvia)); }
  #kpq-{{ section.id }} .kpq__no, #kpq-{{ section.id }} .kpq__medio { color: rgb(150 140 130); }
  #kpq-{{ section.id }} .kpq__oculto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  @media (max-width: 749px) {
    #kpq-{{ section.id }} .kpq__fila { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, .8fr); }
    #kpq-{{ section.id }} .kpq__fila > span { padding: 11px 8px; font-size: .8125rem; flex-direction: column; align-items: flex-start; gap: 4px; }
    #kpq-{{ section.id }} .kpq__fila--cabeza > span { font-size: .75rem; }
  }
  #kpq-{{ section.id }} .kpq__cierre { text-align: center; display: grid; gap: 16px; justify-items: center; }
  #kpq-{{ section.id }} .kpq__cierre p { margin: 0; font-size: 1.125rem; font-style: italic; max-width: 560px; }
</style>

{% schema %}
{
  "name": "Kivoa · Por qué Kivoa",
  "settings": [
    { "type": "text", "id": "etiqueta", "label": "Etiqueta", "default": "¿Por qué Kivoa?" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Un cuadro personalizado, no un cuadro cualquiera" },
    { "type": "textarea", "id": "subtitulo", "label": "Subtítulo", "default": "Un cuadro cualquiera decora una pared. El suyo cuenta quién es." },
    { "type": "checkbox", "id": "mostrar_pilares", "label": "Mostrar los 3 pilares", "default": true },
    { "type": "text", "id": "col_kivoa", "label": "Columna Kivoa", "default": "Kivoa" },
    { "type": "text", "id": "col_otro", "label": "Columna comparada", "default": "Un cuadro cualquiera" },
    { "type": "textarea", "id": "cierre", "label": "Frase final" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón" },
    { "type": "url", "id": "boton_enlace", "label": "Enlace del botón" }
  ],
  "blocks": [
    { "type": "pilar", "name": "Pilar",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "default": "corazon",
          "options": [{ "value": "corazon", "label": "Corazón" }, { "value": "pincel", "label": "Pincel" }, { "value": "huella", "label": "Huella" }, { "value": "marco", "label": "Marco" }] },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Emoción" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ] },
    { "type": "fila", "name": "Fila de la tabla",
      "settings": [
        { "type": "text", "id": "concepto", "label": "Concepto", "default": "Concepto" },
        { "type": "text", "id": "kivoa", "label": "Kivoa (vacío = solo el check)" },
        { "type": "text", "id": "otro", "label": "Cuadro cualquiera (vacío = solo el icono)" },
        { "type": "checkbox", "id": "otro_tiene", "label": "El cuadro cualquiera lo cumple a medias", "default": false }
      ] }
  ],
  "presets": [{ "name": "Kivoa · Por qué Kivoa" }]
}
{% endschema %}
